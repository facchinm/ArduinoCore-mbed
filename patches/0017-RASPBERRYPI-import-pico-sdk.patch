+#define SYSCFG_MEMPOWERDOWN_SRAM4_BITS   0x00000010
+#define SYSCFG_MEMPOWERDOWN_SRAM4_MSB    4
+#define SYSCFG_MEMPOWERDOWN_SRAM4_LSB    4
+#define SYSCFG_MEMPOWERDOWN_SRAM4_ACCESS "RW"
+// -----------------------------------------------------------------------------
