+#define WATCHDOG_TICK_COUNT_MSB    19
+#define WATCHDOG_TICK_COUNT_LSB    11
+#define WATCHDOG_TICK_COUNT_ACCESS "RO"
+// -----------------------------------------------------------------------------
+// Field       : WATCHDOG_TICK_RUNNING
