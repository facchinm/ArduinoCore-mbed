+#define I2C_IC_CLR_RD_REQ_CLR_RD_REQ_BITS   0x00000001
+#define I2C_IC_CLR_RD_REQ_CLR_RD_REQ_MSB    0
+#define I2C_IC_CLR_RD_REQ_CLR_RD_REQ_LSB    0
