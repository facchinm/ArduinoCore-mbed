+#define WATCHDOG_TICK_ENABLE_RESET  0x1
+#define WATCHDOG_TICK_ENABLE_BITS   0x00000200
+#define WATCHDOG_TICK_ENABLE_MSB    9
+#define WATCHDOG_TICK_ENABLE_LSB    9
+#define WATCHDOG_TICK_ENABLE_ACCESS "RW"
