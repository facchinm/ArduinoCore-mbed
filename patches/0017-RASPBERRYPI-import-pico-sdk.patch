+#define UART_UARTCR_RTSEN_BITS   0x00004000
+#define UART_UARTCR_RTSEN_MSB    14
+#define UART_UARTCR_RTSEN_LSB    14
+#define UART_UARTCR_RTSEN_ACCESS "RW"
