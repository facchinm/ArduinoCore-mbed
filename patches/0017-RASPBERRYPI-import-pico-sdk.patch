+#define M0PLUS_MPU_RASR_ENABLE_BITS   0x00000001
+#define M0PLUS_MPU_RASR_ENABLE_MSB    0
+#define M0PLUS_MPU_RASR_ENABLE_LSB    0
+#define M0PLUS_MPU_RASR_ENABLE_ACCESS "RW"
+// =============================================================================
+#endif // HARDWARE_REGS_M0PLUS_DEFINED
