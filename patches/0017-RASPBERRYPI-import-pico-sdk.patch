+#define M0PLUS_MPU_CTRL_PRIVDEFENA_BITS   0x00000004
+#define M0PLUS_MPU_CTRL_PRIVDEFENA_MSB    2
+#define M0PLUS_MPU_CTRL_PRIVDEFENA_LSB    2
+#define M0PLUS_MPU_CTRL_PRIVDEFENA_ACCESS "RW"
