+#define M0PLUS_MPU_CTRL_HFNMIENA_BITS   0x00000002
+#define M0PLUS_MPU_CTRL_HFNMIENA_MSB    1
+#define M0PLUS_MPU_CTRL_HFNMIENA_LSB    1
+#define M0PLUS_MPU_CTRL_HFNMIENA_ACCESS "RW"
